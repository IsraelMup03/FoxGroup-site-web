# Port local (Render fournit PORT automatiquement)
PORT=5000

# URL(s) exacte(s) du frontend, séparées par des virgules, SANS slash final
FRONTEND_URL=http://localhost:5173

# PostgreSQL Supabase : utilisez la chaîne "Session Pooler"
DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Mettre false uniquement pour un PostgreSQL local sans SSL
DATABASE_SSL=true

# Secret JWT : longue chaîne aléatoire
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Compte administrateur créé par "npm run init-db"
ADMIN_NOM=Administrateur
ADMIN_EMAIL=admin@foxgroup.cd
ADMIN_PASSWORD=ChangezCeMotDePasse!

# Cloudinary (images des produits)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=foxgroup/produits

# Taux de change
TAUX_API_URL=https://open.er-api.com/v6/latest/USD
FUSEAU=Africa/Kinshasa
